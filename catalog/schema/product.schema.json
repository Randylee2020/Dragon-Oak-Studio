{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dragonoakstudio.com/catalog/schema/product.schema.json",
  "title": "Dragon Oak Studio canonical product (ADRIAN catalog v1)",
  "description": "One file per product at catalog/products/<SKU>.json. The build (npm run catalog:build) enforces these rules plus cross-product uniqueness of id, sku, slug and etsy.listingId. Etsy is a sales channel: the etsy block is a snapshot from a read-only import, never the product database.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schemaVersion", "id", "sku", "title", "slug", "description", "collection", "subcollection", "productType",
    "tags", "price", "images", "digitalFiles", "etsy", "siteState", "featured", "createdAt", "updatedAt"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{5,63}$", "description": "Internal product ID. Never changes." },
    "sku": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9-]{2,39}$", "description": "The single SKU used on DragonOakStudio.com AND Etsy. The file must be named <sku>.json." },
    "title": { "type": "string", "minLength": 1, "maxLength": 140, "description": "Etsy-compatible title length." },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 80 },
    "description": { "type": "string", "maxLength": 5000, "description": "Plain text. May be empty only while siteState is draft." },
    "collection": {
      "type": "string",
      "enum": ["halloween", "christmas", "cute-bookmarks", "wine-hill-country", "other-seasonal"],
      "description": "Top-level customer collection. Each is independently navigable."
    },
    "subcollection": { "type": ["string", "null"], "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "productType": { "enum": ["digital_download", "physical_product"], "description": "Separate from collection." },
    "tags": {
      "type": "array", "maxItems": 13, "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 20 },
      "description": "Etsy-compatible limits (13 tags, 20 characters each)."
    },
    "price": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object", "additionalProperties": false, "required": ["amountCents", "currency"],
          "properties": {
            "amountCents": { "type": "integer", "minimum": 1 },
            "currency": { "type": "string", "pattern": "^[A-Z]{3}$" }
          }
        }
      ]
    },
    "images": {
      "type": "array", "maxItems": 10,
      "items": {
        "type": "object", "required": ["path", "alt"],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(assets/[A-Za-z0-9._\\-/]+\\.(webp|jpg|jpeg|png)|https://i\\.etsystatic\\.com/.+\\.(webp|jpg|jpeg|png))$",
            "description": "Relative path inside this repo, or a trusted Etsy public image CDN URL imported from the Etsy CSV."
          },
          "alt": { "type": "string", "minLength": 1 }
        }
      }
    },
    "digitalFiles": {
      "type": "array",
      "items": {
        "type": "object", "required": ["ref", "label"],
        "properties": {
          "ref": { "type": "string", "pattern": "^adrian:[A-Za-z0-9._\\-/]+$", "description": "OPAQUE ADRIAN reference. Never a URL or a file path. Never published." },
          "label": { "type": "string", "minLength": 1 },
          "kind": { "type": "string" }
        }
      }
    },
    "etsy": {
      "type": "object", "required": ["listingId", "url", "state", "syncedAt"],
      "properties": {
        "listingId": { "type": ["integer", "null"], "minimum": 1 },
        "url": { "type": ["string", "null"], "pattern": "^https://([a-z0-9-]+\\.)?etsy\\.com/" },
        "state": { "enum": ["not_listed", "draft", "active", "inactive", "sold_out", "expired", "removed"] },
        "syncedAt": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "siteState": { "enum": ["draft", "published", "archived"], "description": "Only published products appear on the site. Published needs a description and at least one existing image." },
    "featured": { "type": "boolean" },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "notes": { "type": "string", "description": "Internal. Never published." },
    "provenance": { "type": "string", "description": "Internal. Never published." }
  }
}
